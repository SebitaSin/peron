# --- Servidor únicamente. Nunca prefijar con NEXT_PUBLIC_ ---
LLM_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-5-5       # con LLM_PROVIDER=openai el default es gpt-4.1

# Sirve personajes en estado "draft" (sin evaluación aprobada). Sólo para pruebas internas.
ALLOW_DRAFT_CHARACTERS=0

# URL pública (no secreta) para OpenGraph. En Vercel se usa VERCEL_PROJECT_PRODUCTION_URL si falta.
NEXT_PUBLIC_SITE_URL=
# Voz natural en la nube (usa OPENAI_API_KEY; sin ella se usa la voz del navegador)
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=ash
# ElevenLabs (voz diseñada con Voice Design; tiene prioridad sobre OpenAI TTS). No usar clones de personas reales.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
